@startuml

' Diagram common configuration
skinparam mainframeBorderColor #lightgrey
hide unlinked
!pragma teoz false

' PUML Framework defined variables 
!define PUML_FRM_VER 1.0
!$URL_BASE = "https://gitlab.int.e-kama.com/open/architecture/dcp/sw-architecture/-/raw/master"
!$COMP_NOTE = "Full Components Description - [[https://confluence.e-kama.com/display/IVI/PUML+Framework+Components+Support Software Subsystems Page]]"

mainframe $CONFIG.DIAGRAM_ID - $CONFIG.DIAGRAM_VER: $CONFIG.DIAGRAM_TITLE\t
right header Author: $CONFIG.AUTHOR

!if ( $CONFIG.TEOZ == true )
   !$FOOTER_NEW_LINE = "\n"  
!else
   !$FOOTER_NEW_LINE = ""  
!endif

right footer $FOOTER_NEW_LINE Autogenerated by [[https://confluence.e-kama.com/display/IVI/PUML+Framework PUML Framework]] v.PUML_FRM_VER

!if ( $CONFIG.SHOW_COMP == true )
  !if ( $DIAGRAM_TYPE == "SEQ" )
     skinparam ArrowColor white
     HELP ->?: Help Page is Activated
  !elseif ( $DIAGRAM_TYPE == "SM" )
  !else
  !endif
!endif

!if ( $CONFIG.HELP == true )
  !if ( $DIAGRAM_TYPE == "SEQ" )
     skinparam ArrowColor white
     HELP ->?: Help Page is Activated
     
     note across
  !elseif ( $DIAGRAM_TYPE == "SM" )
     note as FLOATING
  !else
     note
  !endif
  
    **HELP Menu:**
    \t
    \t
    **Configuration:**
    \t
    ===
    # **HELP** = [true, false] - Show this Help
    # **SHOW_COMP** = [true, false] - Show Defined Components
    # **TEOZ** = [true, false] - Enable/Disable modern TEOZ renderer
    # **AUTHOR** = [str] - The Diagram Author email (e.g. Aleksandr.Golyshkin@atom.info)
    # **DIAGRAM_ID** = [str] - The Diagram Id which contains from pattern **DOMAIN-FEATURE-DIAGRAM_TYPE** (e.g. IVI-OTA-SEQ, IVI-OTA-UC, IVI-OTA-SM).
    # **DIAGRAM_VER** = [str] - The Diagram Version (e.g. v.6)
    # **DIAGRAM_TITLE** = [str] - The Diagram Title (e.g. OTA Initialization)
    \t
    **Variables:**
    \t
    ===
    # **<b>$</b>URL_BASE** = [$URL_BASE] - The base PUML scripts location. Used for simplify '!include' definitions in framework & diagrams.
    \t
    **Includes:**
    \t
    ===
    # **settings/seq.puml** - sequence diagram PUML framework settings (need to include with full URL)
    ## **<b>$</b>URL_BASE/components/external.puml** - external system components
    ## **<b>$</b>URL_BASE/components/generic.puml** - generic components (actors)
    ## **<b>$</b>URL_BASE/components/hw_ift.puml** - IVI IFT domain HW components
    ## **<b>$</b>URL_BASE/components/hw_sfi.puml** - IVI SFI domain HW components
    ## **<b>$</b>URL_BASE/components/hw_vcp.puml** - IVI VCP domain HW components
    ## **<b>$</b>URL_BASE/components/sw_ift.puml** - IVI IFT domain SW components
    ## **<b>$</b>URL_BASE/components/sw_sfi.puml** - IVI SFI domain SW components
    ## **<b>$</b>URL_BASE/components/sw_vcp.puml** - IVI VCP domain SW components
    # **settings/sm.puml** - state machine diagram PUML framework settings (need to include with full URL)
  end note
!endif

!procedure $defineActor( $type, $name, $desc, $stereotype, $order )
    !if $type == "actor"
        actor $name order $order
    !elseif $type == "database"
        database $name order $order
    !else
        participant $name <<$stereotype>> order $order [
        =$name
        ----
        ""$desc""
        ]
    !endif
!endprocedure

' Define actor list holder for each type
!global $sw_ift_actor_list = ""
!global $hw_ift_actor_list = ""

!global $sw_sfi_actor_list = ""
!global $hw_sfi_actor_list = ""

!global $sw_vcp_actor_list = ""
!global $hw_vcp_actor_list = ""

!global $external_actor_list = ""
!global $generic_actor_list = ""

!procedure $addGroup( $comp_type, $feature_name )
    !$varName = "$" + $comp_type + "_actor_list"
    
    !if ( %variable_exists( $varName ) )
      !$entry = "\n**" + $feature_name + "**\n\n"
      %set_variable_value( $varName, %get_variable_value( $varName ) + $entry )
    !endif

!endprocedure

!procedure $addActor( $comp_type, $actor_type, $actor_name, $actor_desc, $actor_stereotype = "none", $order = 0 )
    $defineActor( $actor_type, $actor_name, $actor_desc, $actor_stereotype, $order )
    
    !if ($actor_stereotype == "")
        !$actor_stereotype = "none"
    !endif
    
    !$entry = "# " + "**" + $actor_name + "** <<" + $actor_stereotype + ">> - " + $actor_desc + "\n"

    $setActorList( $comp_type, $entry )
!endprocedure

!procedure $setActorList($comp_type, $entry)
    !$varName = "$" + $comp_type + "_actor_list"
    
    !if ( %variable_exists( $varName ) )
        %set_variable_value( $varName, %get_variable_value( $varName ) + $entry )
    !endif
!endprocedure

!function $getActorList($comp_type)
    !$varName = "$" + $comp_type + "_actor_list"

    !if (%variable_exists($varName))
        !return %get_variable_value( $varName )
    !endif
    !return ""
!endfunction

@enduml
