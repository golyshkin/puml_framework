!include https://gitlab.int.e-kama.com/open/architecture/dcp/sw-architecture/-/raw/master/settings/seq.puml
!include $URL_BASE/components/external.puml
!include $URL_BASE/components/sw_vcp.puml
!include $URL_BASE/components/sw_sfi.puml
!include $URL_BASE/components/sw_ift.puml
'!include $URL_BASE/components/generic.puml

==IVI_VCP UDS Extended Diagnostic Session is established==
SGW -> IVI_VCP ++: Communication Control (0x28)\n[0x00 0x03 - Enable Communication]
activate SGW
IVI_VCP -> IVI_VCP ++: onRunMode()
note over IVI_VCP
IVI_VCP moves to RUN mode.
end note
IVI_VCP -> IVI_VCP : setSocState( RUN )
note over IVI_VCP
IVI_VCP starts sending and recieving non-diagnostic messages to/from CAN.
end note
IVI_VCP -> IVI_VCP: startCanRxTxProcessing()
IVI_VCP -> IVI_SFI --++: SYSTEM_SCP_CTRL_STATE_MACHINE_MODE( RUN )
deactivate IVI_VCP
IVI_SFI -> IVI_SFI ++: onRunMode()
note over IVI_SFI
IVI_SFI starts safety check in SERVICE mode:
\t
# Start handle heartbeats from IVI_IFT
# Start handle DTC requests from IVI_IFT
end note
IVI_SFI -> IVI_SFI: startIftSafetyCheck()
IVI_SFI -> IVI_IFT --++: ATOM_REGISTER_VCP_STATE( RUN )
deactivate IVI_SFI
IVI_IFT -> IVI_IFT ++: onRunMode()
note over IVI_IFT: Start handle heartbeats from IVI_SFI
IVI_IFT -> IVI_IFT --: startSafetyCheck()
IVI_IFT ->> IVI_SFI ++: ATOM_REGISTER_IFT_STATE( RUN )

deactivate IVI_IFT
IVI_SFI -> IVI_VCP ++: SYSTEM_SCP_CTRL_AP_UPDATE_END
note over IVI_VCP
IVI_VCP starts checking IVI_SFI heartbeats and other safety mechanisms.
end note
IVI_VCP -> IVI_VCP: startSafetyCheck()
note over IVI_SFI: Start sending a heartbeats to IVI_VCP
IVI_SFI -> IVI_SFI --: ssm_heartbeat_start()

deactivate IVI_SFI
IVI_VCP --> SGW : UDS PositiveResponse
deactivate SGW
deactivate IVI_VCP