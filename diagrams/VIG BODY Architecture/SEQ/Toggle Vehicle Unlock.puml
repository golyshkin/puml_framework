!$CONFIG = {
"AUTHOR": "Alexandr.Golyshkin@atom.team",
"DIAGRAM_ID": "IVI-VIG-BODY-SEQ",
"DIAGRAM_VER": "v.6",
"DIAGRAM_TITLE": "Toggle Vehicle Unlock"
}

!include https://gitlab.int.e-kama.com/open/architecture/dcp/sw-architecture/-/raw/master/settings/seq.puml
!include $URL_BASE/components/generic.puml
'!include $URL_BASE/components/external.puml
'!include $URL_BASE/components/sw_vcp.puml
'!include $URL_BASE/components/sw_sfi.puml
!include $URL_BASE/components/sw_ift.puml

note right IFT_VA_APP
**Pre-condition:**
\t
IFT_VIG_SRV stored current centarl lock state from IFT_SYNC_SRV.
end note

User o-> IFT_VA_APP : Say phrase from list
activate IFT_VA_APP
IFT_VA_APP -> IFT_VA_APP : Parse phrase
note right of IFT_VA_APP
**Data:**
\t
<code>
"commandId": "<unique id>"
"commandSubject": "DOORS"
"commandName": "toggleLock"
"speakerPosition": ["FrontLeft", "FrontRight", "Rear"]
"enabled": false
</code>
end note
IFT_VA_APP -> IFT_VIG_SRV : auto.atom.action.voice.BODY
activate IFT_VIG_SRV
IFT_VIG_SRV -> IFT_VIG_SRV: handleCommand()
==Guard Conditions==
IFT_VIG_SRV -> IFT_VIG_SRV ++: CheckConditions()
IFT_VIG_SRV -> IFT_VIG_SRV: CheckVehicleSpeed(): speed
opt speed > user.config.kama.general.speed_allow_threshhold_max
  note right of IFT_VA_APP
  **Result Data**
  \t
  <code>
  "action": "auto.atom.action.voice.RESULT"
  "commandId": <unique id>
  "code": "RESULT_UNAVAILABLE_WHILE_DRIVING"
  "data": null
  </code>
  end note
  IFT_VIG_SRV -> IFT_VA_APP: Result Data
  |||
end opt

IFT_VIG_SRV -> IFT_VIG_SRV: CheckChildLock(): childLockState 
opt childLockState = true
  note right of IFT_VA_APP
  **Result Data**
  \t
  <code>
  "action": "auto.atom.action.voice.RESULT"
  "commandId": <unique id>
  "code": "RESULT_CHILD_LOCK_ON"
  "data":
  {
      "doorZones": [ "RearLeft", "RearRight", "Unspecified" ],
      "enabled": true
  }
  </code>
  end note
  IFT_VIG_SRV -> IFT_VA_APP --: Result Data
  |||
end opt
IFT_VIG_SRV -> IFT_VIG_SRV: Check initial_state

alt initial_state = true
    IFT_VIG_SRV -> IFT_SYNC_SRV ++: switchCentralLock( false )
    IFT_SYNC_SRV -> IFT_SYNC_SRV: executeCommand()
    alt 
      IFT_SYNC_SRV --> IFT_VIG_SRV : RESULT_SUCCESS
      IFT_VIG_SRV -> IFT_VIG_SRV: waitResponse()
      |||
    else
      IFT_SYNC_SRV --> IFT_VIG_SRV --: RESULT_NOT_SUPPORTED
      note right of IFT_VA_APP
      **Result Data**
      \t
      <code>
      "action": "auto.atom.action.voice.RESULT"
      "commandId": <unique id>
      "code": "RESULT_NOT_SUPPORTED"
      "data": null
      </code>
      end note
      IFT_VIG_SRV -> IFT_VA_APP --: Result Data
      deactivate IFT_VIG_SRV
      |||
    end alt
==Command Executing==
    IFT_SYNC_SRV o-> IFT_VIG_SRV ++: onSwitchCentralLockChanged( isLock, eventStatus ) 
    alt eventStatus = RESULT_SUCCESS
        note right of IFT_VA_APP
        **Result Data**
        \t
        <code>
        "action": "auto.atom.action.voice.RESULT"
        "commandId": <unique id>
        "code": "RESULT_SUCCESS"
        "data":
        {
            "enabled": false
        }
        </code>
        end note
        IFT_VIG_SRV -> IFT_VA_APP: Result Data
    else eventStatus = [RESULT_TIMEOUT, RESULT_FAILURE]
        note right of IFT_VA_APP
        **Result Data**
        \t
        <code>
        "action": "auto.atom.action.voice.RESULT"
        "commandId": <unique id>
        "code": "RESULT_ERROR_EXECUTION"
        "data": null          
        </code>
        end note
        IFT_VIG_SRV -> IFT_VA_APP: Result Data
    end alt
else else
    note right of IFT_VA_APP
    **Result Data**
    \t
    <code>
    "action": "auto.atom.action.voice.RESULT"
    "commandId": <unique id>
    "code": "RESULT_NOTHING_TO_CHANGE"
    "data":
    {
        "enabled": false
    }
    </code>
    end note
    IFT_VIG_SRV -> IFT_VA_APP --: Result Data
    deactivate IFT_VA_APP
    |||
  end alt